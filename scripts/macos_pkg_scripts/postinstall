set -u

CONSOLE_USER=$(/usr/bin/stat -f '%Su' /dev/console)
if [ -z "${CONSOLE_USER}" ] || [ "${CONSOLE_USER}" = "root" ] || [ "${CONSOLE_USER}" = "_mbsetupuser" ]; then
    echo "superseedr-handler: no logged-in user; registration deferred until superseedr.app is opened"
    exit 0
fi

CONSOLE_UID=$(/usr/bin/id -u "${CONSOLE_USER}")
HANDLER_APP="/Applications/superseedr.app"
HANDLER_EXECUTABLE="${HANDLER_APP}/Contents/MacOS/superseedr-handler"
CONSOLE_HOME=$(/usr/bin/sudo -H -u "${CONSOLE_USER}" /bin/sh -c 'printf "%s" "$HOME"')
INSTALLER_LOG=""

if [ -n "${CONSOLE_HOME}" ]; then
    HANDLER_LOG_DIR="${CONSOLE_HOME}/Library/Application Support/com.github.jagalite.superseedr/logs/handler"
fi

if [ -n "${CONSOLE_HOME}" ] && /bin/launchctl asuser "${CONSOLE_UID}" \
    /usr/bin/sudo -H -u "${CONSOLE_USER}" \
    /bin/mkdir -p "${HANDLER_LOG_DIR}"; then
    INSTALLER_LOG="${HANDLER_LOG_DIR}/installer.log"
    /usr/bin/touch "${INSTALLER_LOG}"
    /usr/sbin/chown "${CONSOLE_USER}" "${INSTALLER_LOG}"
    /bin/chmod 700 "${HANDLER_LOG_DIR}"
    /bin/chmod 600 "${INSTALLER_LOG}"
fi

log_message() {
    local message="superseedr-handler: $*"
    echo "${message}"
    if [ -n "${INSTALLER_LOG}" ]; then
        printf '%s %s\n' "$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')" "${message}" >> "${INSTALLER_LOG}" 2>/dev/null || true
    fi
}

log_verification_output() {
    local phase="$1"
    local output="$2"
    while IFS= read -r line; do
        if [ -n "${line}" ]; then
            log_message "verification_${phase} ${line}"
        fi
    done <<< "${output}"
}

if [ ! -x "${HANDLER_EXECUTABLE}" ]; then
    log_message "registration soft_failed reason=handler_missing"
    exit 0
fi

log_message "registration starting user=${CONSOLE_USER} uid=${CONSOLE_UID}"

BEFORE_OUTPUT=$(/bin/launchctl asuser "${CONSOLE_UID}" \
    /usr/bin/sudo -H -u "${CONSOLE_USER}" \
    "${HANDLER_EXECUTABLE}" --verify)
BEFORE_STATUS=$?
log_verification_output "before" "${BEFORE_OUTPUT}"
log_message "verification_before exit_status=${BEFORE_STATUS}"

if ! /bin/launchctl asuser "${CONSOLE_UID}" \
    /usr/bin/sudo -H -u "${CONSOLE_USER}" \
    /usr/bin/open -W -n -g "${HANDLER_APP}" --args --register-handlers; then
    log_message "registration soft_failed reason=launch"
fi

AFTER_OUTPUT=$(/bin/launchctl asuser "${CONSOLE_UID}" \
    /usr/bin/sudo -H -u "${CONSOLE_USER}" \
    "${HANDLER_EXECUTABLE}" --verify)
AFTER_STATUS=$?
log_verification_output "after" "${AFTER_OUTPUT}"

if [ "${AFTER_STATUS}" -eq 0 ]; then
    log_message "registration verified magnet=yes torrent=yes"
else
    log_message "registration soft_failed reason=verification exit_status=${AFTER_STATUS}; retry_on_app_open=yes"
fi

exit 0
