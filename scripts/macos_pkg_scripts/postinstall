set -u

CONSOLE_USER=$(/usr/bin/stat -f '%Su' /dev/console)
if [ -z "${CONSOLE_USER}" ] || [ "${CONSOLE_USER}" = "root" ] || [ "${CONSOLE_USER}" = "_mbsetupuser" ]; then
    echo "No logged-in user is available; default-handler setup will run when superseedr.app is opened."
    exit 0
fi

CONSOLE_UID=$(/usr/bin/id -u "${CONSOLE_USER}")
HANDLER_APP="/Applications/superseedr.app"

if [ ! -x "${HANDLER_APP}/Contents/MacOS/superseedr-handler" ]; then
    echo "Native protocol handler is missing from superseedr.app."
    exit 0
fi

echo "Registering superseedr for magnet links and torrent files as ${CONSOLE_USER}..."
if ! /bin/launchctl asuser "${CONSOLE_UID}" \
    /usr/bin/sudo -u "${CONSOLE_USER}" \
    /usr/bin/open -n -g "${HANDLER_APP}" --args --register-handlers; then
    echo "Default-handler setup did not complete; it will be retried when superseedr.app is opened."
fi

exit 0
